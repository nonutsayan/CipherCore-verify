# =====================================================================
# CIPHERCORE VERIFY (SIH26261) - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your real Google Cloud & Gemini keys.
# NEVER commit .env to source control!
# =====================================================================

# 1. Google Cloud Vision API (for real OCR & document text detection)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API Key
# Enable "Cloud Vision API" under APIs & Services -> Library
GOOGLE_VISION_API_KEY=

# 2. Google Gemini API (for AI document intelligence & compliance validation)
# Create in Google AI Studio: https://aistudio.google.com/app/apikey
# Recommended models: gemini-1.5-flash (fast, high rate-limit), gemini-2.0-flash, or gemini-1.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Google Identity Services / OAuth 2.0 (for Reviewer Google Sign-In)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID -> Web Application
# Authorized JavaScript Origins: https://nonutsayan.github.io, http://localhost:3000, http://localhost:8080
GOOGLE_CLIENT_ID=

# 4. Optional: Google Drive Integration
GOOGLE_DRIVE_CLIENT_ID=

# 5. Application Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=default
