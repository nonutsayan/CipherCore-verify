# Target & compiled files
target/
backend/target/
*.class
*.jar
*.war

# Database & Runtime Data
*.mv.db
*.trace.db
*.lock.db
data/
uploads/
backend/data/
backend/uploads/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python caches & temporary test scripts
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Local backup files, scratch archives & tool binaries
archive/
tools/
*.backup*
*.zip
*.tmp
*.log

# Hyperframes temporary run artifacts
**/.hyperframes/artifacts/

# OS & Editor generated files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
*.iml
*.exe

# Impeccable clone cache
.impeccable/*
!.impeccable/config.json

# Credentials, API keys, and environment secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
gcp-*.json
service-account*.json
credentials*.json
*.pem
*.key
*.p12
*.jks
